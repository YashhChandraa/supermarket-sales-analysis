import pandas as pd
import matplotlib.pyplot as plt

# Load Dataset
df = pd.read_csv("../data/supermarket_sales.csv")

# -------------------------------
# Sales by Branch
# -------------------------------
branch_sales = df.groupby("Branch")["Total"].sum()

plt.figure(figsize=(6,4))
branch_sales.plot(kind="bar")
plt.title("Sales by Branch")
plt.xlabel("Branch")
plt.ylabel("Total Sales")
plt.tight_layout()
plt.savefig("../images/sales_by_branch.png")
plt.show()

# -------------------------------
# Payment Methods
# -------------------------------
payment = df["Payment"].value_counts()

plt.figure(figsize=(6,4))
payment.plot(kind="pie", autopct="%1.1f%%")
plt.ylabel("")
plt.title("Payment Methods")
plt.tight_layout()
plt.savefig("../images/payment_methods.png")
plt.show()

# -------------------------------
# Monthly Sales
# -------------------------------
monthly = df.groupby("Month")["Total"].sum()

plt.figure(figsize=(6,4))
monthly.plot(kind="line", marker="o")
plt.title("Monthly Sales")
plt.xlabel("Month")
plt.ylabel("Sales")
plt.tight_layout()
plt.savefig("../images/monthly_sales.png")
plt.show()
